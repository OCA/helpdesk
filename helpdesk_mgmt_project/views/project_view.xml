<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    icon="support_agent"
                    name="%(ticket_action_from_project)d"
                    context="{'search_default_project_id': id, 'default_project_id': id}"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                >
                    <div class="o_field_widget o_stat_info">
                        <field name="label_tickets" readonly="1" />
                        <span class="o_stat_value">
                            <field name="ticket_count" />
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath
                expr="//page[@name='settings']//field[@name='label_tasks']"
                position="after"
            >
                <field
                    name="label_tickets"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                />
            </xpath>
        </field>
    </record>
    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_card" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='action_view_tasks']" position="after">
                <a
                    class="d-flex gap-2 align-items-baseline text-muted text-truncate"
                    name="%(ticket_action_from_project)d"
                    type="action"
                    context="{'search_default_project_id': id, 'default_project_id': id}"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                >
                    <i
                        class="oi oi-filled"
                        data-icon="support_agent"
                        title="Tickets"
                        data-tooltip="Tickets"
                    />
                    <span>
                        <field name="ticket_count" class="o_value" />
                        <field name="label_tickets" />
                    </span>
                </a>
            </xpath>
        </field>
    </record>
    <record id="view_project_search" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    string="Open Tickets"
                    name="open_tickets"
                    domain="[('ticket_ids', '!=', False), ('ticket_ids.closed', '=', False)]"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                />
            </xpath>
        </field>
    </record>
</odoo>
