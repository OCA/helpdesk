<odoo>
    <record id="helpdesk_ticket_partner_kanban_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.partner.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <kanban
                class="oe_background_grey o_kanban_dashboard"
                create="0"
                highlight_color="color"
            >
                <field name="name" />
                <field name="color" />
                <field name="avatar_128" />
                <field name="todo_ticket_count" />
                <field name="todo_ticket_count_unassigned" />
                <field name="todo_ticket_count_unattended" />
                <field name="todo_ticket_count_high_priority" />
                <templates>
                    <t t-name="menu">
                        <div class="o_kanban_card_manage_section">
                            <div role="menuitem" class="o_kanban_manage_reports">
                                <div class="o_kanban_card_manage_title ps-4 pb-1">
                                    <span class="fw-bolder">View</span>
                                </div>
                                <a
                                    role="menuitem"
                                    class="dropdown-item"
                                    name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                    type="action"
                                > All
                                </a>
                                <div role="separator" class="dropdown-divider" />
                                <t t-if="widget.editable">
                                    <field name="color" widget="kanban_color_picker" />
                                </t>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="d-flex align-items-center">
                                    <field
                                        name="avatar_128"
                                        widget="image"
                                        class="me-2"
                                        options="{'img_class': 'o_image_40_cover rounded-circle border'}"
                                        alt="Avatar"
                                    />
                                    <div class="o_primary">
                                        <a
                                            name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                            type="action"
                                        >
                                            <field name="name" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div
                                        class="col-6 o_kanban_primary_left"
                                        style="padding-top:20px;"
                                    >
                                        <button
                                            class="btn btn-primary"
                                            name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                            type="action"
                                            context="{'search_default_open': 1}"
                                        >
                                            <t t-esc="record.todo_ticket_count.value" />
                                            To Do
                                        </button>
                                    </div>
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="row">
                                            <div class="col-9">
                                                <a
                                                    name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                                    type="action"
                                                    context="{'search_default_unassigned': 1}"
                                                >
                                                    Unassigned
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t
                                                    t-esc="record.todo_ticket_count_unassigned.value"
                                                />
                                            </div>
                                            <div class="col-9">
                                                <a
                                                    name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                                    type="action"
                                                    context="{'search_default_unattended': 1}"
                                                >
                                                    Unattended
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t
                                                    t-esc="record.todo_ticket_count_unattended.value"
                                                />
                                            </div>
                                            <div class="col-9">
                                                <a
                                                    name="%(action_helpdesk_ticket_kanban_from_partner_dashboard)d"
                                                    type="action"
                                                    context="{'search_default_high_priority': 1}"
                                                >
                                                    High Priority
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t
                                                    t-esc="record.todo_ticket_count_high_priority.value"
                                                />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_partner_tree_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.partner.list</field>
        <field name="model">res.partner</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="todo_ticket_count" string="Active tickets" />
                <field
                    name="todo_ticket_count_unassigned"
                    string="Unassigned tickets"
                />
                <field
                    name="todo_ticket_count_unattended"
                    string="Unattended tickets"
                />
                <field
                    name="todo_ticket_count_high_priority"
                    string="Priority tickets"
                />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>
</odoo>
