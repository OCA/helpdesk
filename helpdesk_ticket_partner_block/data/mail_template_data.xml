<odoo noupdate="1">
    <record id="mail_template_ticket_creation_blocked" model="mail.template">
        <field name="name">Helpdesk Ticket: Creation Blocked</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="subject">Your helpdesk ticket could not be created</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.name" />,</p>
                <p>
                    We are sorry to inform you that your request could not be
                    turned into a helpdesk ticket, as you are not authorized
                    to create tickets by email.
                </p>
                <p>
                    Please get in touch with us through one of our other
                    supported channels if you need assistance.
                </p>
            </div>
        </field>
    </record>
</odoo>
