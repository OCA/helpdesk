<odoo>
    <record model="ir.ui.view" id="ticket_view_form">
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt_project.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='milestone_id']/.." position="after">
                <field name="sale_line_id" invisible="not allow_billable" />
                <field name="allow_billable" invisible="1" />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="timesheet_helpdesk_ticket_view_form">
        <field name="model">helpdesk.ticket</field>
        <field
            name="inherit_id"
            ref="helpdesk_mgmt_timesheet.timesheet_helpdesk_ticket_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='timesheet_ids']/tree/field[@name='unit_amount']"
                position="before"
            >
                <!-- <field name="timesheet_ids"/> is already inside a block groups="hr_timesheet.group_hr_timesheet_user"  -->
                <field name="timesheet_invoice_id" column_invisible="True" />
                <field name="readonly_timesheet" column_invisble="1" />
                <field
                    name="so_line"
                    widget="so_line_field"
                    groups="!sales_team.group_sale_salesman"
                    column_invisible="not parent.allow_billable"
                    readonly="readonly_timesheet"
                    context="{'with_remaining_hours': True, 'with_price_unit': True}"
                    options="{'no_create': True, 'no_open': True}"
                    domain="[('is_service', '=', True), ('order_partner_id.commercial_partner_id.id', 'parent_of', parent.partner_id), ('is_expense', '=', False), ('state', '=', 'sale'), ('is_downpayment', '=', False)]"
                    optional="hide"
                />
                <field
                    name="so_line"
                    widget="so_line_field"
                    groups="sales_team.group_sale_salesman"
                    column_invisible="not parent.allow_billable"
                    readonly="readonly_timesheet"
                    context="{'with_remaining_hours': True, 'with_price_unit': True}"
                    options="{'no_create': True, 'no_open': True}"
                    domain="[('is_service', '=', True), ('order_partner_id.commercial_partner_id.id', 'parent_of', parent.partner_id), ('is_expense', '=', False), ('state', '=', 'sale'), ('is_downpayment', '=', False)]"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="ticket_view_tree">
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt_project.ticket_view_tree" />
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="sale_line_id" column_invisible="True" />
            </field>
        </field>
    </record>
</odoo>
