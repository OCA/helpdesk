<odoo>

    <record id="ticket_view_form" model="ir.ui.view">
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_account_moves"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    groups="account.group_account_user"
                >
                    <field
                        string="Account Moves"
                        name="account_move_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>
    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('account_move_ids', 'in', active_id)]</field>
        <field name="context">{'default_account_move_ids': [(4, active_id)]}</field>
    </record>



</odoo>
