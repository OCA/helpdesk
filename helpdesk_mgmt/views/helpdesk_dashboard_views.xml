<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_kanban_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.team.kanban</field>
        <field name="model">helpdesk.ticket.team</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_mobile"
                create="0"
                js_class="helpdesk_mgmt_overview_kanban"
                highlight_color="color"
                sample="1"
                action="action_overview_open_team_tickets"
                type="object"
            >
                <field name="name" />
                <field name="color" />
                <field name="alias_email" />
                <field name="open_ticket_count" />
                <field name="unassigned_tickets" />
                <field name="urgent_ticket" />
                <field name="ticket_closed" />
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-6">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title"
                                    >
                                        <span>View</span>
                                    </h5>
                                    <div role="menuitem">
                                        <a
                                            name="action_overview_open_team_tickets"
                                            type="object"
                                        >Tickets</a>
                                    </div>
                                </div>
                                <div t-if="widget.editable" class="col-6">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title"
                                    >
                                        <span>Customize</span>
                                    </h5>
                                    <field name="color" widget="kanban_color_picker" />
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card" class="px-3">
                        <field name="name" class="fw-bold fs-4" />
                        <small t-if="record.alias_email.value" class="ms-2">
                            <a t-att-href="'mailto:' + record.alias_email.value">
                                <i
                                    class="fa fa-envelope-o"
                                    title="Team email alias"
                                    role="img"
                                    aria-label="Team email alias"
                                />
                                <field name="alias_email" />
                            </a>
                        </small>
                        <div class="row mt-3">
                            <div class="col-4">
                                <button
                                    class="btn btn-primary o_helpdesk_ticket_btn"
                                    name="action_overview_open_team_tickets"
                                    type="object"
                                    context="{'default_team_id': id}"
                                >
                                    Tickets
                                </button>
                            </div>
                            <div class="col-8">
                                <a
                                    name="action_overview_team_closed_week"
                                    type="object"
                                    title="Number of tickets closed in the past 7 days."
                                    class="justify-content-between flex-nowrap d-inline-flex w-100 mb4"
                                >
                                    <span>Tickets Closed</span>
                                    <field
                                        name="ticket_closed"
                                        class="ms-3 text-nowrap"
                                    />
                                </a>
                            </div>
                        </div>
                        <div class="row pt-3 mt-auto">
                            <a
                                name="action_overview_team_open_tickets"
                                type="object"
                                class="d-flex flex-column align-items-center col"
                            >
                                <field name="open_ticket_count" class="fw-bold" />
                                <span class="text-muted text-nowrap">Open</span>
                            </a>
                            <a
                                name="%(action_helpdesk_ticket_kanban_from_dashboard)d"
                                type="action"
                                context="{'default_team_id': id, 'search_default_unassigned': 1}"
                                class="d-flex flex-column align-items-center col border-start"
                            >
                                <field name="unassigned_tickets" class="fw-bold" />
                                <span class="text-muted text-nowrap">Unassigned</span>
                            </a>
                            <a
                                name="action_overview_team_urgent_tickets"
                                type="object"
                                class="d-flex flex-column align-items-center col border-start"
                            >
                                <field name="urgent_ticket" class="fw-bold" />
                                <span class="text-muted text-nowrap">Urgent</span>
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
