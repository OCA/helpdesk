<odoo>

    <record model="ir.ui.view" id="stock_picking_type_form_view">
        <field name="name">stock.picking.type.form</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <group name="locations" position="after">
                <group
                    string="Helpdesk"
                    groups="helpdesk_mgmt.group_helpdesk_user"
                    name="helpdesk"
                >
                    <field name="allow_helpdesk_ticket" />
                    <field name="default_helpdesk_team_id" />
                </group>
            </group>
        </field>
    </record>
</odoo>
