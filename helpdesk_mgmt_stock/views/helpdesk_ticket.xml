<odoo>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']/parent::group" position="after">
                <group string="Stock" name="stock">
                    <field name="stock_picking_id" />
                    <field name="stock_move_id" domain="stock_move_id_domain" />
                    <field name="lot_id" readonly="0" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
