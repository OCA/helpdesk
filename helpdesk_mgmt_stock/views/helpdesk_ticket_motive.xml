<odoo>
    <record model="ir.ui.view" id="helpdesk_ticket_motive_form_view">
        <field name="model">helpdesk.ticket.motive</field>
        <field name="inherit_id" ref="helpdesk_motive.helpdesk_ticket_motive_form" />
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <group name="stock" string="Stock">
                    <field name="location_dest_id" />
                </group>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="helpdesk_ticket_motive_tree">
        <field name="model">helpdesk.ticket.motive</field>
        <field name="inherit_id" ref="helpdesk_motive.helpdesk_ticket_motive_tree" />
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="location_dest_id" />
            </field>
        </field>
    </record>
</odoo>
