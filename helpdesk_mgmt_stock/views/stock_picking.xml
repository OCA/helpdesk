<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    attrs="{'invisible': [('helpdesk_ticket_allowed', '=', False)]}"
                    name="action_view_helpdesk_tickets"
                    type="object"
                    icon="fa-life-ring"
                    context="{'default_partner_id': partner_id}"
                >
                    <field name="helpdesk_ticket_allowed" invisible="1" />
                    <field
                        string="Tickets"
                        name="helpdesk_tickets_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>

    <record id="view_picking_tree" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='state']" position="before">
                <field name="helpdesk_tickets_count" invisible="1" />
                <field name="helpdesk_ticket_allowed" invisible="1" />
                <button
                    name="create_or_show_helpdesk_ticket"
                    type="object"
                    icon="fa-life-ring"
                    string="Helpdesk"
                    attrs="{'invisible': ['|', ('helpdesk_ticket_allowed', '=', False), ('helpdesk_tickets_count', '>', 0)]}"
                />
                <button
                    name="create_or_show_helpdesk_ticket"
                    type="object"
                    icon="fa-life-ring"
                    string="Helpdesk"
                    class="btn btn-danger"
                    attrs="{'invisible': ['|', ('helpdesk_ticket_allowed', '=', False), ('helpdesk_tickets_count', '&lt;=', 0)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="name">stock.picking.internal.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <filter name="activities_exception" position="after">
                <separator />
                <filter
                    string="Open Helpdesk Tickets"
                    name="activities_exception"
                    domain="[('helpdesk_ticket_ids.stage_id.closed', '=', False)]"
                />
            </filter>
        </field>
    </record>

</odoo>
