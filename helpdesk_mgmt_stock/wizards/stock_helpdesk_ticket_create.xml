<odoo>
    <record model="ir.ui.view" id="stock_helpdesk_ticket_create_form_view">
        <field name="model">stock.helpdesk.ticket.create</field>
        <field name="arch" type="xml">
            <form string="Stock Helpdesk Ticket Create">
                <group>
                    <field name="description" />
                    <field name="stock_move_id" domain="stock_move_id_domain" />
                    <field name="stock_picking_id" />
                </group>
                <footer>
                    <button
                        name="action_create_helpdesk_ticket"
                        string="Create Ticket"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="stock_helpdesk_ticket_create_act_window">
        <field name="name">Stock Helpdesk Ticket Create</field>
        <field name="res_model">stock.helpdesk.ticket.create</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>
