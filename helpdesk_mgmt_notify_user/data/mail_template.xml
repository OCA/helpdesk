<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Email template -->
        <record id="mail_template_old_assign_en" model="mail.template">
            <field name="auto_delete" eval="True" />
            <field name="email_from">{{(object.team_id and object.team_id.user_id and
                object.team_id.user_id.email) or user.email or ''}}</field>
            <field name="name">Helpdesk: Notification to previous assignee</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
            <field name="subject">Change of assignee on ticket "{{object.name}}"</field>
            <field name="email_to">{{object.former_user_id.partner_id.email}}</field>
            <field
                name="body_html"
            ><![CDATA[
                <p>Hello <t t-esc="object.former_user_id.name" />,</p>
                <p>The ticket <strong>
                        <t t-esc="object.name" />
                    </strong> you were assigned to has been assigned to another user.</p>
                <p>
                    <ul>
                        <li>New assignee: <t t-esc="object.user_id.name" /></li>
                        <li>Reason: Manual reassignment of the request</li>
                    </ul>
                </p>
                <p>
                    <a t-att-href="object.get_portal_url()">Access the ticket</a>
                </p>]]>
            </field>
        </record>
    </data>
    <data noupdate="1">
        <record id="mail_template_new_assign_en" model="mail.template">
            <field name="name">Helpdesk: Notification to new assignee</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
            <field name="subject">New assigned ticket: {{object.name}}</field>
            <field name="email_to">{{object.user_id.partner_id.email}}</field>
            <field
                name="body_html"
            ><![CDATA[
                <p>Hello <t t-esc="object.user_id.name" /></p>
                <p>The ticket <strong>
                        <t t-esc="object.name" />
                    </strong> has just been assigned to you.</p>
                <p>
                    <ul>
                        <li>Source: <t t-esc="object.team_id.name" /></li>
                        <li>Ticket description: <t
                                t-esc="object.description or ''"
                            /></li>
                    </ul>
                </p>
                <p>
                    <a t-att-href="object.get_portal_url()">Access the ticket</a>
                </p>]]>
            </field>
            <field name="auto_delete" eval="True" />
            <field name="email_from">{{(object.team_id and object.team_id.user_id and
                object.team_id.user_id.email) or user.email or ''}}</field>
        </record>
    </data>
</odoo>
