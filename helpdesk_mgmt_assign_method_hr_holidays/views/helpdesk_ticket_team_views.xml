<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_team_form_view" model="ir.ui.view">
        <field name="name">helpdesk.ticket.team.form.inherit</field>
        <field name="model">helpdesk.ticket.team</field>
        <field
            name="inherit_id"
            ref="helpdesk_mgmt_assign_method.helpdesk_ticket_team_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assign_method']" position="after">
                <field
                    name="assign_tickets_to_users_on_leave"
                    invisible="assign_method == 'manual'"
                />
            </xpath>
        </field>
    </record>
</odoo>
