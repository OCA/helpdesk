<odoo>
    <record id="fsm_equipment_form_view" model="ir.ui.view">
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_helpdesk_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring"
                    groups="helpdesk_mgmt.group_helpdesk_user_own"
                >
                    <field
                        name="helpdesk_ticket_count"
                        widget="statinfo"
                        string="Tickets"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
